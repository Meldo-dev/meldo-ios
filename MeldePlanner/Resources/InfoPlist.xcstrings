  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo nutzt die Kamera, um Klassenarbeiten und Arbeitsblätter als PDF zu scannen. Die Scans speichert Meldo auf deinem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldo uses the camera to scan tests and worksheets as PDFs. Meldo saves the scans on your device."
          }
        }
      }
    }
  },
  "version": "1.0"
}
